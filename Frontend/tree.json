{
  "project": "Vela AI - Full Multi-Page System",
  "stack": ["React", "TypeScript"],
  "instructions": "Đặc tả cây component toàn bộ hệ thống Vela AI (Assistant, Dashboard, Tasks, Projects, Login, Register). Tái sử dụng tối đa các Shared UI Components nền tảng.",
  "designTokens": {
    "filePath": "src/styles/tokens.css",
    "variables": {
      "--brand": "#4F6EF7",
      "--brand-600": "#3f5ae0",
      "--brand-soft": "#EEF1FE",
      "--bg": "#FBFBFD",
      "--panel": "#FFFFFF",
      "--line": "#ECEEF3",
      "--line-2": "#F1F3F7",
      "--text": "#1E2632",
      "--muted": "#8A93A6",
      "--muted-2": "#AEB6C4",
      "--ok": "#10B981",
      "--warn": "#F59E0B",
      "--danger": "#EF4444",
      "--radius": "16px",
      "--shadow": "0 1px 2px rgba(16,24,40,.04), 0 8px 24px rgba(16,24,40,.05)",
      "--font": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
    }
  },
  "sharedTypesFile": "src/types/assistant.ts",
  "sharedTypes": [
    {
      "name": "AiModelId",
      "kind": "type",
      "definition": "'auto' | 'claude' | 'gpt' | 'gemini'"
    },
    {
      "name": "NavItemData",
      "kind": "interface",
      "fields": {
        "id": "string",
        "label": "string",
        "href": "string",
        "icon": "string",
        "active": "boolean?"
      }
    },
    {
      "name": "AttnCategory",
      "kind": "interface",
      "fields": {
        "key": "string",
        "label": "string",
        "count": "number"
      }
    },
    {
      "name": "ChatMessage",
      "kind": "interface",
      "fields": {
        "id": "string",
        "role": "'user' | 'assistant'",
        "content": "string",
        "model": "AiModelId?",
        "createdAt": "string"
      }
    },
    {
      "name": "UserProfile",
      "kind": "interface",
      "fields": {
        "name": "string",
        "role": "string",
        "avatarUrl": "string",
        "rating": "number",
        "level": "number",
        "managedStaff": "number",
        "achievementPoints": "number"
      }
    },
    {
      "name": "TaskItem",
      "kind": "interface",
      "fields": {
        "id": "string",
        "title": "string",
        "assignee": "string",
        "dueDate": "string",
        "status": "'todo' | 'in_progress' | 'done'",
        "priority": "'low' | 'medium' | 'high'"
      }
    },
    {
      "name": "ProjectItem",
      "kind": "interface",
      "fields": {
        "id": "string",
        "title": "string",
        "progress": "number",
        "members": "number",
        "deadline": "string",
        "status": "string"
      }
    },
    {
      "name": "KpiMetric",
      "kind": "interface",
      "fields": {
        "id": "string",
        "title": "string",
        "value": "string",
        "unit": "string?",
        "changePercent": "number?",
        "icon": "string"
      }
    }
  ],
  "sharedComponents": [
    {
      "name": "Icon",
      "filePath": "src/components/ui/Icon.tsx",
      "cssClass": "svg-ico",
      "description": "Component icon SVG dùng chung, nhận prop 'name' và map ra path tương ứng.",
      "props": { "name": "string", "size": "number?" }
    },
    {
      "name": "Dropdown",
      "filePath": "src/components/ui/Dropdown.tsx",
      "cssClass": "lang-menu | notif-menu | role-menu",
      "description": "Component dropdown menu dùng chung cho tất cả menu popup.",
      "props": { "isOpen": "boolean", "onClose": "() => void" }
    },
    {
      "name": "Overlay",
      "filePath": "src/components/ui/Overlay.tsx",
      "cssClass": "overlay",
      "description": "Backdrop mờ phía sau modal/menu, click để đóng.",
      "props": { "visible": "boolean", "onClick": "() => void" }
    },
    {
      "name": "ToastProvider",
      "filePath": "src/components/ui/Toast.tsx",
      "cssClass": "toast-wrap",
      "description": "Context + container hiển thị thông báo toast.",
      "props": {}
    },
    {
      "name": "Footer",
      "filePath": "src/components/ui/Footer.tsx",
      "cssClass": "foot",
      "description": "Footer cố định cuối trang.",
      "props": {}
    },
    {
      "name": "Button",
      "filePath": "src/components/ui/Button.tsx",
      "cssClass": "btn | btn-primary | btn-sm | btn-approve | btn-reject",
      "description": "Nút bấm dùng chung toàn ứng dụng.",
      "props": { "variant": "'default' | 'primary' | 'approve' | 'reject'?", "size": "'sm' | 'md' | 'lg'?", "children": "ReactNode", "onClick": "() => void?" }
    },
    {
      "name": "Panel",
      "filePath": "src/components/ui/Panel.tsx",
      "cssClass": "panel | panel-h",
      "description": "Khung thẻ/khối chứa nội dung chung với viền và bo góc.",
      "props": { "title": "string?", "children": "ReactNode", "className": "string?" }
    },
    {
      "name": "KpiCard",
      "filePath": "src/components/ui/KpiCard.tsx",
      "cssClass": "kpi | kpi-ico | kpi-meta",
      "description": "Thẻ hiển thị chỉ số KPI với icon, giá trị và nhãn.",
      "props": { "metric": "KpiMetric" }
    },
    {
      "name": "Chip",
      "filePath": "src/components/ui/Chip.tsx",
      "cssClass": "chip | st-todo | st-in_progress | st-done | pdot",
      "description": "Nhãn nhãn trạng thái/tag.",
      "props": { "label": "string", "variant": "'default' | 'todo' | 'in_progress' | 'done'?" }
    },
    {
      "name": "Avatar",
      "filePath": "src/components/ui/Avatar.tsx",
      "cssClass": "avatar | mini-ava | avatar-img",
      "description": "Hình đại diện/chữ viết tắt của người dùng.",
      "props": { "name": "string", "src": "string?", "size": "number?" }
    },
    {
      "name": "Modal",
      "filePath": "src/components/ui/Modal.tsx",
      "cssClass": "modal",
      "description": "Hộp thoại popup modal.",
      "props": { "isOpen": "boolean", "title": "string", "onClose": "() => void", "children": "ReactNode" }
    },
    {
      "name": "AuthLayout",
      "filePath": "src/components/ui/AuthLayout.tsx",
      "cssClass": "shell auth-shell",
      "description": "Khung layout dành riêng cho các trang đăng nhập / đăng ký (không dùng Sidebar).",
      "props": { "children": "ReactNode" }
    }
  ],
  "trees": [
    {
      "name": "AssistantPage",
      "filePath": "src/app/AssistantPage.tsx",
      "domTag": "div",
      "description": "Trang Trợ lý AI Vela.",
      "children": []
    },
    {
      "name": "DashboardPage",
      "filePath": "src/app/DashboardPage.tsx",
      "domTag": "div",
      "description": "Trang Bảng điều hành tổng quan.",
      "children": [
        {
          "name": "DashboardKpiGrid",
          "filePath": "src/features/dashboard/DashboardKpiGrid.tsx",
          "cssClass": "dash-kpi kpi-grid",
          "domTag": "div",
          "description": "Grid 3 thẻ KPI chỉ số hoạt động chính."
        },
        {
          "name": "ActivityTimeline",
          "filePath": "src/features/dashboard/ActivityTimeline.tsx",
          "cssClass": "panel act-row",
          "domTag": "div",
          "description": "Dòng thời gian hoạt động mới nhất."
        },
        {
          "name": "QuickSchedule",
          "filePath": "src/features/dashboard/QuickSchedule.tsx",
          "cssClass": "panel cal-cell",
          "domTag": "div",
          "description": "Widget lịch làm việc & sự kiện nhanh."
        },
        {
          "name": "TeamMindmap",
          "filePath": "src/features/dashboard/TeamMindmap.tsx",
          "cssClass": "panel mm-branches mm-node",
          "domTag": "div",
          "description": "Sơ đồ cây tổ chức & nhân sự nhóm."
        }
      ]
    },
    {
      "name": "TasksPage",
      "filePath": "src/app/TasksPage.tsx",
      "domTag": "div",
      "description": "Trang Quản lý Công việc.",
      "children": [
        {
          "name": "TaskHeader",
          "filePath": "src/features/tasks/TaskHeader.tsx",
          "cssClass": "page-head",
          "domTag": "header",
          "description": "Tiêu đề trang & các nút Tạo công việc, Tìm kiếm."
        },
        {
          "name": "TaskFilterTabs",
          "filePath": "src/features/tasks/TaskFilterTabs.tsx",
          "cssClass": "tabs tab",
          "domTag": "div",
          "description": "Thanh tab lọc trạng thái (Tất cả, Đang làm, Cần duyệt...)."
        },
        {
          "name": "TaskTable",
          "filePath": "src/features/tasks/TaskTable.tsx",
          "cssClass": "task-table",
          "domTag": "table",
          "description": "Bảng danh sách công việc chi tiết."
        },
        {
          "name": "TaskDetailDrawer",
          "filePath": "src/features/tasks/TaskDetailDrawer.tsx",
          "cssClass": "modal task-drawer",
          "domTag": "div",
          "description": "Drawer/Modal xem và sửa chi tiết công việc."
        }
      ]
    },
    {
      "name": "ProjectsPage",
      "filePath": "src/app/ProjectsPage.tsx",
      "domTag": "div",
      "description": "Trang Quản lý Dự án.",
      "children": [
        {
          "name": "ProjectHeader",
          "filePath": "src/features/projects/ProjectHeader.tsx",
          "cssClass": "page-head",
          "domTag": "header",
          "description": "Tiêu đề trang & nút Tạo dự án mới."
        },
        {
          "name": "ProjectKpiGrid",
          "filePath": "src/features/projects/ProjectKpiGrid.tsx",
          "cssClass": "kpi-grid",
          "domTag": "div",
          "description": "Thống kê tổng số dự án đang chạy, hoàn thành, chậm tiến độ."
        },
        {
          "name": "ProjectGrid",
          "filePath": "src/features/projects/ProjectGrid.tsx",
          "cssClass": "dash-grid cl-card",
          "domTag": "div",
          "description": "Danh sách các thẻ dự án (Project Cards)."
        }
      ]
    },
    {
      "name": "LoginPage",
      "filePath": "src/app/LoginPage.tsx",
      "domTag": "div",
      "description": "Trang Đăng nhập tài khoản.",
      "children": [
        {
          "name": "LoginForm",
          "filePath": "src/features/auth/LoginForm.tsx",
          "cssClass": "panel login-form demo-pill",
          "domTag": "form",
          "description": "Form đăng nhập + nút tài khoản demo."
        }
      ]
    },
    {
      "name": "RegisterPage",
      "filePath": "src/app/RegisterPage.tsx",
      "domTag": "div",
      "description": "Trang Đăng ký tài khoản mới.",
      "children": [
        {
          "name": "RegisterForm",
          "filePath": "src/features/auth/RegisterForm.tsx",
          "cssClass": "panel login-form",
          "domTag": "form",
          "description": "Form đăng ký tài khoản mới."
        }
      ]
    }
  ]
}
